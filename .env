# 暂时保留，方便直接使用
# ====== 环境 ======
APP_ENV=dev

# ====== Redis（云端）======
REDIS_URL=
REDIS_PREFIX=dev
SESSION_TTL_SECONDS=7200

# Milvus / Zilliz Cloud
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=qa_collection
MILVUS_TOP_K=5

# ====== Qwen（OpenAI 兼容模式）======
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_CHAT_MODEL=
QWEN_EMBED_MODEL=

# ====== PostgreSQL（用于 /end 落库 public.chat_history）=====
# 推荐：使用 DSN（等价于 DATABASE_URL）
POSTGRES_DSN=

# ======（暂时可保留）PostgreSQL：给现有脚本用 ======
PGHOST=
PGPORT=
PGUSER=
PGDATABASE=telecom
PGSSLMODE=disable
PGPASSWORD=
# ====== 路由 ======
ROUTER_MODE=react
